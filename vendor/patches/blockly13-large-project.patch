+import * as Blockly from '#core/blockly.js';
+import {BlockDragStrategy} from '#core/dragging/block_drag_strategy.js';
+import {assert} from 'chai';
+import sinon from 'sinon';
+import {
+  DEFAULT_INJECT_OPTIONS,
+  sharedTestSetup,
+  sharedTestTeardown,
+} from './test_helpers/setup_teardown.js';
+
+suite('Render batch text cache', function () {
+  let workspace: Blockly.WorkspaceSvg;
+
+  setup(function (this: Mocha.Context) {
+    sharedTestSetup.call(this, {fireEventsNow: false});
+    Blockly.defineBlocksWithJsonArray([
+      {type: 'batch_label', message0: 'Repeated batch label'},
+    ]);
+    workspace = Blockly.inject('blocklyDiv', DEFAULT_INJECT_OPTIONS);
+  });
+
+  teardown(function (this: Mocha.Context) {
+    sharedTestTeardown.call(this, workspace);
+  });
+
+  function createBlocks(ws: Blockly.WorkspaceSvg, count: number) {
+    return Array.from({length: count}, () => {
+      const block = ws.newBlock('batch_label');
+      block.initSvg();
+      block.queueRender();
+      return block;
+    });
+  }
+
+  test('measures repeated labels once per batch and releases between batches', function () {
+    const blocks = createBlocks(workspace, 30);
+    const style = sinon.spy(window, 'getComputedStyle');
+    const measurements = () =>
+      style
+        .getCalls()
+        .filter((call) => call.args[0].textContent === 'Repeated batch label')
+        .length;
+    Blockly.renderManagement.triggerQueuedRenders();
+    assert.equal(measurements(), 1);
