+    const manager = workspace.getLayerManager();
+    if (!manager) throw new Error('Missing layer manager');
+    const dragLayer = manager.getDragLayer();
+    assert.isDefined(dragLayer);
+    const blockLayer = manager.getBlockLayer();
+    // jsdom lacks atomic moves. Exercise dispatch with real connected SVG
+    // nodes here; focus retention is verified in the Electron pointer test.
+    const move = sinon.spy(function (this: SVGGElement, child: Node) {
+      this.appendChild(child);
+    });
+    for (const layer of [dragLayer, blockLayer]) {
+      Object.defineProperty(layer, 'moveBefore', {
+        value: move,
+        configurable: true,
+      });
+    }
+    manager.moveToDragLayer(block, false);
+    assert.strictEqual(block.getSvgRoot().parentNode, dragLayer);
+    manager.moveOffDragLayer(block, Blockly.layers.BLOCK, false);
+    assert.strictEqual(block.getSvgRoot().parentNode, blockLayer);
+    assert.equal(move.callCount, 2);
+  });
