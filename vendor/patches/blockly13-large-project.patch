+/**
+ * @license
+ * Copyright 2026 Raspberry Pi Foundation
+ * SPDX-License-Identifier: Apache-2.0
+ */
+import * as Blockly from '#core/blockly.js';
+import {assert} from 'chai';
+import type sinon from 'sinon';
+import {
+  DEFAULT_INJECT_OPTIONS,
+  sharedTestSetup,
+  sharedTestTeardown,
+} from './test_helpers/setup_teardown.js';
+
+suite('Scoped focus indicators', function () {
+  let workspace: Blockly.WorkspaceSvg;
+  let clock: sinon.SinonFakeTimers;
+
+  setup(function (this: Mocha.Context) {
+    ({clock} = sharedTestSetup.call(this, {fireEventsNow: false}));
+    Blockly.defineBlocksWithJsonArray([
+      {
+        type: 'focus_field_probe',
+        message0: '%1',
+        args0: [{type: 'field_input', name: 'VALUE', text: 'value'}],
+      },
+    ]);
+    workspace = Blockly.inject('blocklyDiv', DEFAULT_INJECT_OPTIONS);
+  });
+
+  teardown(function (this: Mocha.Context) {
+    sharedTestTeardown.call(this, workspace);
+  });
+
+  test('preserves native active and passive field focus without marking the tree as a field', function () {
+    const block = workspace.newBlock('focus_field_probe');
+    block.initSvg();
+    Blockly.renderManagement.triggerQueuedRenders();
+    const field = block.getField('VALUE');
+    assert.exists(field);
+    if (!field) return;
+    const manager = Blockly.getFocusManager();
+    manager.focusNode(field);
+    clock.runAll();
+    const element = field.getFocusableElement();
+    assert.isTrue(element.classList.contains('blocklyActiveFocus'));
+    assert.isTrue(element.classList.contains('blocklyActiveFieldFocus'));
+    const external = document.createElement('button');
+    document.body.append(external);
+    try {
+      const restore = manager.takeEphemeralFocus(external);
+      assert.isTrue(element.classList.contains('blocklyPassiveFieldFocus'));
+      assert.isFalse(element.classList.contains('blocklyActiveFieldFocus'));
+      restore();
+      assert.isTrue(element.classList.contains('blocklyActiveFieldFocus'));
+      manager.focusNode(workspace);
+      clock.runAll();
+      assert.isFalse(element.classList.contains('blocklyActiveFieldFocus'));
+      assert.isFalse(element.classList.contains('blocklyPassiveFieldFocus'));
+      assert.isFalse(
+        workspace
+          .getFocusableElement()
+          .classList.contains('blocklyActiveFieldFocus'),
+      );
+    } finally {
+      external.remove();
+    }
+  });
+});
