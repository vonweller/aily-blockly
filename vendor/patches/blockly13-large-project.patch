+  test('iterative connection walk retains input/next order and collapsed and shadow rules', function () {
+    Blockly.defineBlocksWithJsonArray([
+      {
+        type: 'batch_row',
+        message0: '%1',
+        args0: [{type: 'input_statement', name: 'BODY'}],
+        previousStatement: null,
+        nextStatement: null,
+      },
+    ]);
+    const [root, nested, tail] = Array.from({length: 3}, () =>
+      workspace.newBlock('batch_row'),
+    );
+    root
+      .getInput('BODY')
+      ?.connection?.connect(nested.previousConnection as Blockly.Connection);
+    root.nextConnection?.connect(tail.previousConnection as Blockly.Connection);
+    const strategy = new BlockDragStrategy(root);
+    const visit = () => strategy['getAllConnections'](root);
+    const own = (block: Blockly.BlockSvg) => [
+      block.previousConnection,
+      block.getInput('BODY')?.connection,
+      block.nextConnection,
+    ];
+    assert.deepEqual(visit(), [
+      own(root)[0],
+      own(root)[1],
+      ...own(nested),
+      own(root)[2],
+      ...own(tail),
+    ]);
+    root.setCollapsed(true);
+    assert.deepEqual(visit(), [
+      root.previousConnection,
+      root.nextConnection,
+      ...own(tail),
+    ]);
+    tail.setShadow(true);
+    assert.deepEqual(visit(), [root.previousConnection, root.nextConnection]);
+  });
